# ── Stage 1: Build ────────────────────────────────────────
FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app

# Manifests for layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY backend/package.json ./backend/
COPY packages/shared/package.json ./packages/shared/
COPY frontend/package.json ./frontend/

RUN pnpm install --frozen-lockfile

# Source
COPY tsconfig.base.json ./
COPY packages/shared/ ./packages/shared/
COPY frontend/ ./frontend/

# Build shared + patch exports for compiled output
RUN pnpm --filter @openskillhub/shared build \
    && sed -i 's|./src/index.ts|./dist/index.js|g' packages/shared/package.json

# Build Next.js (standalone output)
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm --filter @openskillhub/frontend build

# ── Stage 2: Runtime ──────────────────────────────────────
FROM node:22-alpine
WORKDIR /app

# Next.js standalone output includes full monorepo structure
COPY --from=builder /app/frontend/.next/standalone ./
COPY --from=builder /app/frontend/.next/static ./frontend/.next/static

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["node", "frontend/server.js"]
