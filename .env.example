# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://openskillhub:openskillhub@localhost:5432/openskillhub

# Server
SERVER_PORT=3001
SERVER_HOST=0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Storage (local | s3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# S3/MinIO (when STORAGE_TYPE=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=openskillhub-packages
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
